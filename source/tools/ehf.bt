//------------------------------------------------
//--- 010 Editor Binary Template
//
//      File: ehf.bt
//   Authors: Reverse-engineered from default.xex (Fable 2 Xbox 360)
//   Version: 1.0
//   Purpose: Parse Fable 2 "HeightFieldGraphicsFile" (.ehf) terrain
//            graphics files.
//
//   ONLY contains structures CONFIRMED from the IDA decompilation of
//   sub_82A855A8 + helpers (sub_82B25728, sub_82B25930, sub_82B250E8,
//   sub_82A1C110, sub_82A1BEA8, sub_82B25850, sub_82A1BD30) and
//   validated to walk chapter3's body to body_end exactly (0 bytes
//   remaining).
//
//   ANYTHING not confirmed (tex[2..3] internal structure, DB0 PF=99
//   texture interpretation, the exact meaning of the per-cell vertex
//   data layout) is left as opaque BYTE arrays so we don't pretend to
//   understand fields we don't.
//
//   The file uses Xbox 360 big-endian encoding throughout.
//------------------------------------------------

BigEndian();

// ---- Header (63 bytes, validated) -----------------------------------

typedef struct {
    char     magic[23];          // "HeightFieldGraphicsFile"
    BYTE     header_unknown[32]; // 32 bytes of (unconfirmed) header data
    uint32   body_offset;        // offset to start of body (typically 0x3F)
    uint32   body_size;          // size of body in bytes
} EhfHeader;

// ---- Texture blob (CONFIRMED for PF=24 lightmap, PF=40 normal) -----
//
// Layout (from sub_82B852D0 / sub_82B85E88):
//   +0x00  uint32 magic        = 0xFFFFFFFE
//   +0x04  uint32 raw_hint
//   +0x08  uint32 flags_or_zero
//   +0x0C  uint32 header_count
//   +0x10  uint32 Width
//   +0x14  uint32 Height
//   +0x18  uint32 PixelFormat  ( 24 = lightmap,
//                                40 = BC5 normal,
//                                98 = uncompressed (raw payload only),
//                                99 = unknown blob format )
//   +0x1C  uint32 flags2
//   +0x20  uint32 mip_table_offset (typically 0x54)
//          ...zero padding to mip_table_offset...
//   +mt+0  uint32 raw_size      (size of uncompressed pixel data)
//   For PF != 98:
//     +mt+4  uint32 comp_size    (size of zlib-deflated payload)
//     +mt+8  ubyte  zlib_stream[comp_size]
//   For PF == 98:
//     +mt+4  ubyte  raw_payload[raw_size]   (no zlib wrapper)

typedef struct {
    uint32  magic <format=hex>;           // 0xFFFFFFFE
    uint32  raw_hint;
    uint32  unknown_0;
    uint32  header_count;
    uint32  TextureWidth;
    uint32  TextureHeight;
    uint32  PixelFormat;
    uint32  unknown_1;
    uint32  mip_table_offset;             // = 0x54

    if (mip_table_offset > 0x24) {
        BYTE pad[mip_table_offset - 0x24];
    }

    uint32 raw_size;
    if (PixelFormat == 98) {
        // Uncompressed payload — raw_size bytes follow raw_size field.
        BYTE   raw_payload[raw_size];
    } else {
        uint32 comp_size;
        BYTE   zlib_stream[comp_size];
    }
} TexBlob <read=ReadTexBlob>;

string ReadTexBlob(TexBlob &t) {
    string s;
    SPrintf(s, "PF=%u  %ux%u  raw=%u  comp=%s",
            t.PixelFormat, t.TextureWidth, t.TextureHeight, t.raw_size,
            t.PixelFormat == 98 ? "N/A" : Str("%u", t.comp_size));
    return s;
}

// ---- Mesh tile entry (sub_82A850A0 / sub_82B250E8) ------------------
//
// CONFIRMED layout per tile:
//   - 4 u32s: f_a, f_b, w_sub, h_sub
//   - w_sub * h_sub cells, each 160 bytes:
//       * 4 × vec4 (16B each = 64B)  -- 4 vec4 reads (sub_82A1C110)
//       * 8 × vec3 (12B each = 96B)  -- 8 vec3 reads (sub_82A1BEA8)
//   - 24B trailer (2 × sub_82A1BEA8 = 24B)
//
// Internal field meanings of the cell vec4s/vec3s are NOT confirmed
// (probably terrain mesh positions + normals + UVs + tangents, but the
// loader squares the first four vec4s, which is unexplained).  We
// leave the cell contents as opaque BYTE arrays.

typedef struct {
    float    f_a;
    float    f_b;
    uint32   w_sub;
    uint32   h_sub;
    BYTE     cells[w_sub * h_sub * 160];
    BYTE     trailer[24];
} MeshTile <read=ReadMeshTile>;

string ReadMeshTile(MeshTile &m) {
    string s;
    SPrintf(s, "%ux%u cells  (%u bytes mesh data)",
            m.w_sub, m.h_sub, m.w_sub * m.h_sub * 160);
    return s;
}

// ---- sub_82A860E8 entries ------------------------------------------
// Just a count + N × 18 bytes. Per-entry structure unknown.

typedef struct {
    BYTE  bytes[18];
} A860E8Entry;

// ---- LOD palette entry (sub_82A85F20 / sub_82A81748) ----------------
//
// CONFIRMED: 6 null-terminated ASCII strings interleaved with two 12B
// blocks of float/u32 data:
//   1. 3 strings (BaseLayer diffuse / BaseLayer normal / blank?)
//   2. 12 bytes (some floats — exact meaning not confirmed)
//   3. 3 more strings (DetailLayer diffuse / DetailLayer normal / blank?)
//   4. 12 bytes
//
// In chapter3 each entry's strings have the pattern:
//   strs[0] = "art\themetextures\grass_diffuse.tex"
//   strs[1] = "art\themetextures\grass_normal.tex"
//   strs[2] = ""
//   strs[3] = "art\environment\_groundtextures\cliffi_diffuse.tex"
//   strs[4] = "art\environment\_groundtextures\cliffe_normal.tex"
//   strs[5] = ""

typedef struct {
    string  base_diffuse;        // null-terminated
    string  base_normal;
    string  base_extra;
    BYTE    mid_floats[12];
    string  detail_diffuse;
    string  detail_normal;
    string  detail_extra;
    BYTE    tail_floats[12];
} LodEntry <read=ReadLodEntry>;

string ReadLodEntry(LodEntry &e) {
    return e.base_diffuse;
}

// ---- Per-chunk per-layer (sub_82B25930) -----------------------------
//
// CONFIRMED: 24 bytes per layer, from these reads:
//   - sub_82B25850: 4 bytes (u32) — internal hash/id, byte-swapped
//   - 4 bytes: u32 name_idx (index into chunk's layer-name list)
//   - sub_82A1BD30: 8 bytes (2 floats) — per-layer parameters, the
//     ACTUAL tile-scale comes from a lookup via name_idx, not from
//     these floats (formula is 16.0 / lookup_value, computed at load).
//   - 8 bytes: 4 × (u8 texture_idx, u8 blend) — per-CORNER (4 corners
//     of the chunk) material index into the LOD palette + blend
//     amount used in alpha-stacking against the layer below.

typedef struct {
    uint32   layer_hash;         // sub_82B25850 output
    uint32   name_idx;           // → index into per-chunk layer-name list
    float    layer_param0;       // tile UV offset or rotation? not yet confirmed
    float    layer_param1;
    struct {
        ubyte texture_idx;       // index into LOD palette
        ubyte blend;             // 0..255 alpha for this corner
    } corner[4];                 // 4 corners of the chunk (BL, BR, TL, TR ordering)
} ChunkLayer <read=ReadChunkLayer>;

string ReadChunkLayer(ChunkLayer &L) {
    string s;
    SPrintf(s, "name_idx=%u  tex=[%u,%u,%u,%u]  blend=[%u,%u,%u,%u]",
            L.name_idx,
            L.corner[0].texture_idx, L.corner[1].texture_idx,
            L.corner[2].texture_idx, L.corner[3].texture_idx,
            L.corner[0].blend, L.corner[1].blend,
            L.corner[2].blend, L.corner[3].blend);
    return s;
}

// ---- Per-chunk (sub_82B25728) ---------------------------------------
//
// CONFIRMED:
//   - 3 floats: world-space origin x,y,z
//   - 3 floats: world-space extent x,y,z  (chunk's bounding box size)
//   - u32 layer_count
//   - layer_count × ChunkLayer (24B each)

typedef struct {
    float    origin_x;
    float    origin_y;
    float    origin_z;
    float    extent_x;
    float    extent_y;
    float    extent_z;
    uint32   layer_count;
    if (layer_count > 0)
        ChunkLayer layers[layer_count] <optimize=false>;
} Chunk <read=ReadChunk>;

string ReadChunk(Chunk &c) {
    string s;
    SPrintf(s, "origin=(%.1f,%.1f,%.1f) extent=(%.1f,%.1f,%.1f) layers=%u",
            c.origin_x, c.origin_y, c.origin_z,
            c.extent_x, c.extent_y, c.extent_z, c.layer_count);
    return s;
}

// ---- Final pass (sub_82A854D8) --------------------------------------
//
// CONFIRMED: u8 flag + cnt_860e8 × (u32 sub_count + sub_count × 8B).
// Per-entry sub-data structure not yet decoded.

typedef struct {
    ubyte   flag;
    // The number of FinalEntry items equals the count of
    // sub_82A860E8 entries earlier in the file.  We don't have a
    // forward reference here, so we just consume until end-of-body
    // when this template hits the end of the buffer.  In 010 we
    // declare it after the chunks where the count is known.
} FinalPassHeader;

typedef struct {
    uint32   sub_count;
    BYTE     sub_data[sub_count * 8];
} FinalEntry <read=ReadFinalEntry>;

string ReadFinalEntry(FinalEntry &f) {
    string s;
    SPrintf(s, "sub_count=%u", f.sub_count);
    return s;
}

// ============================================================ MAIN ===

LittleEndian();   // 010 default, will be overridden below
BigEndian();

EhfHeader hdr;
Assert(Strncmp(hdr.magic, "HeightFieldGraphicsFile", 23) == 0,
       "missing HeightFieldGraphicsFile magic");

FSeek(hdr.body_offset);
local int64 body_start = FTell();
local int64 body_end   = body_start + hdr.body_size;

// --- Step 1: 2 textures (lightmap + normal map) -------------------
TexBlob lightmap;       // PF=24, dimensions == heightfield grid size
TexBlob normal_map;     // PF=40 BC5

// --- Step 2: 1 float (engine state[+176]) -------------------------
float    state_176;

// --- Step 3: mesh tile vector ------------------------------------
uint32   mesh_tile_count;
if (mesh_tile_count > 0 && mesh_tile_count < 10000)
    MeshTile mesh_tiles[mesh_tile_count] <optimize=false>;

// --- Step 4: sub_82A860E8 vector ---------------------------------
float    a860e8_float;
uint32   a860e8_count;
if (a860e8_count > 0 && a860e8_count < 100000)
    A860E8Entry a860e8_entries[a860e8_count] <optimize=false>;

// --- Step 5: 2 more textures (tex[2..3]) -------------------------
//
// PARTIALLY UNDERSTOOD: tex[2] is typically PF=98 (uncompressed) with
// an unusual aspect (e.g. 816x48 for chapter3).  tex[3] may or may
// not be present.  In chapter3 there is an additional ~21KB of
// trailing unknown bytes between tex[2] and the LOD palette.
//
// Because the byte budget here is not fully decoded, we leave this
// region as a raw blob spanning from current pos to the first "art\\"
// substring's preceding count u32.  Use the "Find" feature in 010 to
// locate "art\\" in the file; the u32 just before it is the LOD count.
//
// Anything decoded here is speculative — DO NOT trust it.

local int64 lod_count_pos;
local int    found_anchor = 0;
local int64  scan_pos = FTell();
while (scan_pos + 4 < body_end) {
    if (ReadByte(scan_pos)     == 'a' &&
        ReadByte(scan_pos + 1) == 'r' &&
        ReadByte(scan_pos + 2) == 't' &&
        ReadByte(scan_pos + 3) == '\\') {
        lod_count_pos = scan_pos - 4;
        found_anchor = 1;
        break;
    }
    scan_pos++;
}

if (found_anchor) {
    BYTE    tex23_and_unknown[lod_count_pos - FTell()];

    // --- Step 6: LOD palette --------------------------------------
    uint32  lod_count;
    if (lod_count > 0 && lod_count < 200)
        LodEntry lods[lod_count] <optimize=false>;

    // --- Step 7: sub_82A85DB0 textures (DB0) ----------------------
    uint32  db0_tex_count;
    if (db0_tex_count > 0 && db0_tex_count < 100) {
        TexBlob db0_textures[db0_tex_count] <optimize=false>;
    }

    // --- Step 8: chunk grid W, H ---------------------------------
    uint32  chunk_grid_w;
    uint32  chunk_grid_h;

    // --- Step 9: W*H chunks --------------------------------------
    Assert(chunk_grid_w > 0 && chunk_grid_w < 1024,
           "chunk grid W out of range");
    Assert(chunk_grid_h > 0 && chunk_grid_h < 1024,
           "chunk grid H out of range");
    Chunk chunks[chunk_grid_w * chunk_grid_h] <optimize=false>;

    // --- Step 10: final pass --------------------------------------
    FinalPassHeader final_hdr;
    if (a860e8_count > 0 && a860e8_count < 100000)
        FinalEntry final_entries[a860e8_count] <optimize=false>;
} else {
    Warning("could not find LOD palette anchor 'art\\' — file may be truncated or have a different layout");
}
